---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 — Cupie Danny" lang="en">
  <Header lang="en" />
  <main class="notfound">
    <img
      class="notfound-image"
      src="https://media.cabin1701.com/japoneson/404/cupie-danny-teacup.jpg"
      alt="Cupie Danny, a small figure with a rainbow beard, peeking out of a teacup"
      width="1000"
      height="750"
    />

    <p class="notfound-code">404</p>

    <div class="notfound-lines">
      <p class="notfound-line">
        <span class="notfound-msg">I'm Cupie Danny. The page you were looking for isn't here. Come play at my house.</span>
        <a class="notfound-link" href="/en/">cupiedanny.com/en/</a>
      </p>
      <p class="notfound-line">
        <span class="notfound-msg">Soy Cupie Danny. La página que buscabas no está aquí. Ven a jugar a mi casa.</span>
        <a class="notfound-link" href="/es/">cupiedanny.com/es/</a>
      </p>
    </div>
  </main>
  <Footer lang="en" />
</Layout>

<style>
  .notfound {
    max-width: 860px;
    margin: 2.5rem auto 4rem;
    padding: 0 1.5rem;
    text-align: center;
  }

  .notfound-image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 420px;
    margin: 0 auto;
    border-radius: 8px;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.22);
  }

  .notfound-code {
    font-size: clamp(2.4rem, 8vw, 4rem);
    color: var(--color-accent);
    margin: 1.5rem 0 0.5rem;
    letter-spacing: 0.08em;
  }

  .notfound-lines {
    max-width: 560px;
    margin: 0 auto;
  }

  .notfound-line {
    margin: 0 0 1.2rem;
    line-height: 1.7;
  }

  .notfound-msg {
    display: block;
    color: var(--color-text);
    font-size: 1.1rem;
  }

  .notfound-link {
    display: inline-block;
    margin-top: 0.2rem;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    font-size: 0.95rem;
  }
</style>
