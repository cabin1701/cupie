---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectHero from '../../components/ProjectHero.astro';

const base = import.meta.env.BASE_URL;

// トップはカードの入口。話のページは japoneson にある（2026-10-30、船長の決定）
const cards = [
  { title: 'La historia', desc: 'Cómo una muñeca Cupie de cien yenes se convirtió en Cupie Danny: Nueva York, Cuba y un homenaje a Juan-Carlos Formell.', image: `${base}images/cupie/hero_cupie.jpg`, href: `https://japoneson.com/es/cupie/`, external: true },
  { title: 'Músicos y Celebridades', desc: 'Cupie Danny con los músicos y las estrellas que conoció.', image: `${base}images/cupie/hero_gallery-01.jpg`, href: `${base}es/gallery-01/`, external: false },
  { title: 'Amigos y Familia', desc: 'Cupie Danny con amigos y familia.', image: `${base}images/cupie/hero_gallery-02.jpg`, href: `${base}es/gallery-02/`, external: false },
  { title: 'Viajes y Aventuras', desc: 'Un viajero diminuto y desnudo, de Nueva York a Cuba.', image: `${base}images/cupie/hero_gallery-03.jpg`, href: `${base}es/gallery-03/`, external: false },
  { title: 'Teatro', desc: 'Cupie Danny, el hermano mayor siempre desnudo, y su hermanita Shoko-chan.', image: `${base}images/cupie/hero_theater.jpg`, href: `${base}es/theater/`, external: false },
];
---

<Layout title="Cupie Danny" description={'Una muñeca Cupie de tienda de cien yenes idéntica a Danny Rojo de espaldas: tatuajes de bolígrafo, bigotes de arcoíris y un viajero diminuto.'} lang="es" ogImage="images/cupie/hero_cupie.jpg">
  <Header lang="es" />
  <main>
    <ProjectHero
      title="Cupie Danny"
      valign="bottom"
      titleFont="'Fredoka', sans-serif"
      titleWeight={600}
      titleSize="70px"
      titleColor="var(--color-accent)"
      image={`${base}images/cupie/hero_entrance.jpg`}
      align="center"
      height={860}
      fit="cover"
    />

    <section class="cards-section">
      <div class="grid">
        {cards.map((c) => (
          <a class="card" href={c.href}>
            <div class="card-img-wrap"><img src={c.image} alt={c.title} loading="lazy" /></div>
            <div class="card-body">
              <h2 class="card-title">{c.title}</h2>
              <p class="desc">{c.desc}</p>
              {c.external && <span class="external-tag">En Japonéson</span>}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer lang="es" />
</Layout>

<style>
  .cards-section {
    max-width: var(--container-max);
    margin: 3rem auto 4rem;
    padding: 0 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 2rem;
  }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
  .card { color: var(--color-text); text-decoration: none; display: block; }
  .card:hover .card-title { color: var(--color-accent); }
  .card-img-wrap { width: 100%; aspect-ratio: 1 / 1; overflow: hidden; margin-bottom: 1rem; }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-body { text-align: center; }
  .card-title {
    font-family: var(--font-nav);
    font-weight: 500;
    font-size: 28px;
    color: var(--color-navy);
    margin: 0 0 4px;
    line-height: 1.2;
  }
  .desc {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 16px;
    color: #333;
    line-height: 1.55;
    margin: 8px 0 0;
  }
  .external-tag {
    display: inline-block;
    margin-top: 0.6rem;
    font-family: var(--font-nav);
    font-size: 0.85rem;
    color: var(--color-accent);
  }
</style>
