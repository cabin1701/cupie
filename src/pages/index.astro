---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Cupie Danny"
  description="A 100-yen Cupie doll that looked just like Danny Rojo from behind — ballpoint tattoos, rainbow whiskers, and a tiny traveler from New York to Cuba."
  ogImage="images/cupie/hero_cupie.jpg"
>
  <main class="entrance" style={`background-image: url('${base}images/cupie/hero_entrance.jpg');`}>
    <div class="entrance-inner">
      <h1 class="entrance-title">Cupie Danny</h1>
      <p class="entrance-sub">Danny Rojo &amp; Seina</p>
      <ul class="entrance-langs">
        <li><a href={`${base}en/`}>English</a></li>
        <li><a href={`${base}es/`}>Español</a></li>
      </ul>
    </div>
  </main>
</Layout>

<style>
  /* 入口は japoneson と同じく画面いっぱい。文字は中の HERO と同じ Fredoka（2026-10-30、船長） */
  .entrance {
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem 3vh;
  }
  .entrance-title {
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: clamp(48px, 9vw, 110px);
    color: var(--color-accent);
    line-height: 1.05;
    margin: 0;
    text-shadow: 0 0 18px rgba(255, 255, 255, 0.9), 0 0 4px rgba(255, 255, 255, 0.9);
  }
  .entrance-sub {
    font-family: 'Fredoka', sans-serif;
    font-weight: 500;
    font-size: clamp(20px, 3vw, 30px);
    color: #fff;
    margin: 0.4rem 0 1.2rem;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.6);
  }
  .entrance-langs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .entrance-langs a {
    display: inline-block;
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: 1.4rem;
    color: #fff;
    background: var(--color-accent);
    padding: 0.6rem 2rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .entrance-langs a:hover { opacity: 0.85; }
</style>
